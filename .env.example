# --- AdMob (Android build) ---
# App ID from AdMob > Apps > App settings (looks like ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY).
# Used by scripts/prepare-android.mjs to patch AndroidManifest.xml.
ADMOB_APP_ID="ca-app-pub-3940256099942544~3347511713"   # Google TEST app id

# Ad unit IDs (AdMob > Apps > Ad units). Ignored while testing.
VITE_ADMOB_BANNER_ID=""
VITE_ADMOB_INTERSTITIAL_ID=""
VITE_ADMOB_REWARDED_ID=""

# Keep "true" while developing (Google test ads). Set "false" only for the release you publish.
VITE_ADMOB_TESTING="true"
